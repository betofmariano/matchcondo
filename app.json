{
  "expo": {
    "name": "MatchCondo",
    "slug": "matchcondo",
    "version": "1.0.1",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "matchcondo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.linkpower.matchcondo"
    },
    "android": {
      "package": "br.com.linkpower.matchcondo",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#0F4D3A"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./public/icon-192.png",
      "name": "MatchCondo",
      "shortName": "MatchCondo",
      "themeColor": "#0F7A6C"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#F4F6F4",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#F4F6F4"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita o acesso às suas fotos para escolher uma imagem.",
          "cameraPermission": "Permita o acesso à câmera para tirar uma foto.",
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/"
    },
    "extra": {
      "router": {}
    },
    "owner": "betomariamo"
  }
}
